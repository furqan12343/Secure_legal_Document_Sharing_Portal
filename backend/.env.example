APP_NAME="Secure Legal Document Exchange Portal"
DATABASE_URL="sqlite:///./secure_legal_portal.db"
JWT_SECRET_KEY="replace-with-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="60"

# Generate with: python scripts/generate_key.py
FILE_MASTER_KEY_BASE64="replace-with-generated-base64-key"

MAX_UPLOAD_MB="10"
ALLOWED_EXTENSIONS=".pdf,.png,.jpg,.jpeg,.txt,.docx,.doc"
