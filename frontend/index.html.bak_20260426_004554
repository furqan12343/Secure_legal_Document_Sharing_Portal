      // --- Requests Page (Scenario 1) ---
      function RequestsPage() {
        const { user } = useAuth();
        if (user.role === Role.ASSISTANT) {
          return (
            <div className="space-y-6">
              <h1 className="text-2xl font-bold text-slate-900">Permission requests</h1>
              <div className={cls.card}>
                <div className="flex items-start gap-3">
                  <Icon.AlertCircle width={20} height={20} className="mt-0.5 text-primary-600"/>
                  <div>
                    <h3 className="font-semibold text-slate-900">How requests work</h3>
                    <p className="mt-1 text-sm text-slate-600">
                      To request access to a document, go to the <strong>Documents</strong> page,
                      find a document shared with you, and click the key icon next to it. The lawyer
                      who owns the document will be notified and can approve or deny your request.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          );
        }
        return <LawyerApprovalQueue/>;
      }

      function LawyerApprovalQueue() {
        const [requests, setRequests] = useState([]);
        const [loading, setLoading] = useState(true);
        const [error, setError] = useState(null);
        const [success, setSuccess] = useState(null);
        const [resolveTarget, setResolveTarget] = useState(null);

        const refresh = useCallback(async () => {
          setLoading(true); setError(null);
          try {
            const data = await api("/sharing/pending");
            setRequests(data.requests || []);
          } catch (err) {
            setError(err.error);
          } finally {
            setLoading(false);
          }
        }, []);
        useEffect(() => { refresh(); }, [refresh]);

        async function onDeny(req) {
          if (!confirm("Deny this permission request?")) return;
          try {
            await api(`/sharing/deny/${req.id}`, { method: "POST" });
            setSuccess("Request denied");
            refresh();
          } catch (err) {
            setError(err.error);
          }
        }

        if (loading) return <PageLoader/>;
        return (
          <div className="space-y-6">
            <div>
              <h1 className="text-2xl font-bold text-slate-900">Pending requests</h1>
              <p className="text-sm text-slate-600">Permission requests from assistants awaiting your decision.</p>
            </div>
            {error && <Banner type="error" message={error} onDismiss={() => setError(null)}/>}
            {success && <Banner type="success" message={success} onDismiss={() => setSuccess(null)}/>}

            {requests.length === 0 ? (
              <EmptyState title="No pending requests" description="When an assistant requests permission to one of your documents, it will appear here."/>
            ) : (
              <div className="space-y-3">
                {requests.map(req => (
                  <div key={req.id} className={cls.card}>
                    <div className="flex flex-wrap items-start justify-between gap-4">
                      <div className="flex-1">
                        <p className="text-sm text-slate-500">Document</p>
                        <p className="font-mono text-xs text-slate-700">{req.document_id}</p>
                        <div className="mt-3 grid gap-3 sm:grid-cols-2">
                          <div>
                            <p className="text-xs text-slate-500">Requester</p>
                            <p className="font-mono text-sm text-slate-900">{req.requester_id}</p>
                          </div>
                          <div>
                            <p className="text-xs text-slate-500">Requested at</p>
                            <p className="text-sm text-slate-900">{formatDate(req.requested_at)}</p>
                          </div>
                        </div>
                        {req.justification && (
                          <div className="mt-3">
                            <p className="text-xs text-slate-500">Justification</p>
                            <p className="text-sm text-slate-700">{req.justification}</p>
                          </div>
                        )}
                      </div>
                      <div className="flex flex-col gap-2 sm:flex-row">
                        <button onClick={() => setResolveTarget(req)} className={cls.btnPrimary}>
                          <Icon.Check width={16} height={16}/>Approve
                        </button>
                        <button onClick={() => onDeny(req)} className={cls.btnDanger}>
                          <Icon.X width={16} height={16}/>Deny
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {resolveTarget && (
              <ApproveModal request={resolveTarget} onClose={() => setResolveTarget(null)}
                onDone={(m) => { setResolveTarget(null); setSuccess(m); refresh(); }} onError={setError}/>
            )}
          </div>
        );
      }

      function ApproveModal({ request, onClose, onDone, onError }) {
        const [permissionType, setPermissionType] = useState(PermissionType.VIEW);
        const [expires, setExpires] = useState(30);
        const [submitting, setSubmitting] = useState(false);

        async function onSubmit() {
          setSubmitting(true);
          try {
            await api("/sharing/approve", {
              method: "POST",
              body: JSON.stringify({
                request_id: request.id,
                permission_type: permissionType,
                expires_in_days: expires === "" ? null : Number(expires),
              }),
            });
            onDone("Request approved and access granted");
          } catch (err) {
            onError(err.error);
          } finally {
            setSubmitting(false);
          }
        }

        return (
          <Modal title="Approve request" onClose={onClose}>
            <div className="space-y-4">
              <div>
                <label className={cls.label}>Permission to grant</label>
                <select value={permissionType} onChange={(e) => setPermissionType(e.target.value)}
                  className={cls.input} disabled={submitting}>
                  <option value={PermissionType.VIEW}>View only</option>
                  <option value={PermissionType.DOWNLOAD}>Download</option>
                  <option value={PermissionType.SHARE}>Share (re-grant)</option>
                </select>
              </div>
              <div>
                <label className={cls.label}>Expires in (days)</label>
                <input type="number" min={1} max={365} value={expires}
                  onChange={(e) => setExpires(e.target.value === "" ? "" : Number(e.target.value))}
                  className={cls.input} placeholder="Never expires" disabled={submitting}/>
              </div>
              <div className="flex justify-end gap-2 pt-2">
                <button onClick={onClose} className={cls.btnSecondary} disabled={submitting}>Cancel</button>
                <button onClick={onSubmit} className={cls.btnPrimary} disabled={submitting}>
                  {submitting && <Spinner size={16}/>}Grant access
                </button>
              </div>
            </div>
          </Modal>
        );
      }

      // --- Profile Page ---
      function ProfilePage() {
        const [profile, setProfile] = useState(null);
        const [activity, setActivity] = useState([]);
        const [loading, setLoading] = useState(true);
        const [error, setError] = useState(null);
        const [success, setSuccess] = useState(null);
        const [pwd, setPwd] = useState({ current: "", next: "", confirm: "" });
        const [submittingPwd, setSubmittingPwd] = useState(false);

        useEffect(() => {
          let cancelled = false;
          (async () => {
            try {
              const [p, a] = await Promise.all([api("/users/me"), api("/users/me/activity?limit=20")]);
              if (!cancelled) { setProfile(p.profile); setActivity(a.activity || []); }
            } catch (err) {
              if (!cancelled) setError(err.error);
            } finally {
              if (!cancelled) setLoading(false);
            }
          })();
          return () => { cancelled = true; };
        }, []);

        async function onChangePwd(e) {
          e.preventDefault();
          setError(null);
          if (pwd.next !== pwd.confirm) return setError("New passwords do not match");
          if (pwd.next === pwd.current) return setError("New password must differ from current");
          setSubmittingPwd(true);
          try {
            const res = await api("/users/me/password", {
              method: "PUT",
              body: JSON.stringify({ current_password: pwd.current, new_password: pwd.next }),
            });
            setSuccess(res.message || "Password changed successfully");
            setPwd({ current: "", next: "", confirm: "" });
          } catch (err) {
            setError(err.error);
          } finally {
            setSubmittingPwd(false);
          }
        }

        if (loading) return <PageLoader/>;
        if (!profile) return <Banner type="error" message="Could not load profile"/>;

        return (
          <div className="space-y-6">
            <h1 className="text-2xl font-bold text-slate-900">Profile & settings</h1>
            {error && <Banner type="error" message={error} onDismiss={() => setError(null)}/>}
            {success && <Banner type="success" message={success} onDismiss={() => setSuccess(null)}/>}

            <div className={cls.card}>
              <h2 className="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-900">
                <Icon.User width={18} height={18}/>Account information
              </h2>
              <dl className="grid gap-4 sm:grid-cols-2">
                <PRow label="Full name" value={profile.full_name}/>
                <PRow label="Email" value={profile.email}/>
                <PRow label="Role" value={<RoleBadge role={profile.role}/>}/>
                <PRow label="Status" value={
                  <span className={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium ${profile.is_active ? "bg-emerald-100 text-emerald-800" : "bg-red-100 text-red-800"}`}>
                    {profile.is_active ? "Active" : "Inactive"}
                  </span>
                }/>
                <PRow label="Member since" value={formatDate(profile.created_at)}/>
                <PRow label="Last login" value={profile.last_login_at ? formatDate(profile.last_login_at) : "—"}/>
              </dl>
            </div>

            <div className={cls.card}>
              <h2 className="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-900">
                <Icon.Key width={18} height={18}/>Change password
              </h2>
              <p className="mb-4 text-sm text-slate-600">
                You'll need to enter your current password as proof of identity. Distinct from
                admin-initiated reset (FR12) — both are audited.
              </p>
              <form onSubmit={onChangePwd} className="grid gap-4 md:grid-cols-2" noValidate>
                <div className="md:col-span-2">
                  <label className={cls.label}>Current password</label>
                  <input type="password" required value={pwd.current} onChange={(e) => setPwd({...pwd, current: e.target.value})}
                    className={cls.input} disabled={submittingPwd}/>
                </div>
                <div>
                  <label className={cls.label}>New password</label>
                  <input type="password" required minLength={8} maxLength={72} value={pwd.next}
                    onChange={(e) => setPwd({...pwd, next: e.target.value})} className={cls.input} disabled={submittingPwd}/>
                  <p className="mt-1 text-xs text-slate-500">≥8 chars, with uppercase, lowercase & digit.</p>
                </div>
                <div>
                  <label className={cls.label}>Confirm new password</label>
                  <input type="password" required value={pwd.confirm}
                    onChange={(e) => setPwd({...pwd, confirm: e.target.value})} className={cls.input} disabled={submittingPwd}/>
                </div>
                <div className="md:col-span-2">
                  <button type="submit" className={cls.btnPrimary}
                    disabled={submittingPwd || !pwd.current || !pwd.next || !pwd.confirm}>
                    {submittingPwd && <Spinner size={16}/>}
                    {submittingPwd ? "Changing…" : "Change password"}
                  </button>
                </div>
              </form>
            </div>

            <div className={cls.card}>
              <h2 className="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-900">
                <Icon.Activity width={18} height={18}/>Recent activity
              </h2>
              <p className="mb-4 text-sm text-slate-600">Your recent actions. All entries are HMAC-signed for tamper detection.</p>
              {activity.length === 0 ? (
                <EmptyState title="No recent activity"/>
              ) : (
                <div className="overflow-hidden rounded-lg border border-slate-200">
                  <table className="min-w-full divide-y divide-slate-200 text-sm">
                    <thead className="bg-slate-50"><tr><Th>Action</Th><Th>Resource</Th><Th>IP</Th><Th>When</Th></tr></thead>
                    <tbody className="divide-y divide-slate-200 bg-white">
                      {activity.map((e, i) => (
                        <tr key={i}>
                          <Td className="font-mono text-xs">{e.action}</Td>
                          <Td className="font-mono text-xs text-slate-500">{e.resource_id ? e.resource_id.slice(0,8) : "—"}</Td>
                          <Td className="font-mono text-xs text-slate-500">{e.ip_address || "—"}</Td>
                          <Td className="text-xs">{formatDate(e.timestamp)}</Td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        );
      }
      function PRow({ label, value }) {
        return (
          <div>
            <dt className="text-xs font-medium uppercase tracking-wide text-slate-500">{label}</dt>
            <dd className="mt-1 text-sm text-slate-900">{value}</dd>
          </div>
        );
      }

      // --- Admin Users Page (Process 2) ---
