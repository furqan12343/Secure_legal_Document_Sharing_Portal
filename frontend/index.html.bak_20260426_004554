      // --- Admin Audit Integrity Page (DREAD #5 mitigation) ---
      function AuditIntegrityPage() {
        const [result, setResult] = useState(null);
        const [loading, setLoading] = useState(false);
        const [error, setError] = useState(null);

        async function runCheck() {
          setLoading(true); setError(null);
          try {
            const data = await api("/admin/audit/integrity");
            setResult(data.integrity_check);
          } catch (err) {
            setError(err.error);
          } finally {
            setLoading(false);
          }
        }

        return (
          <div className="space-y-6">
            <div>
              <h1 className="text-2xl font-bold text-slate-900">Audit log integrity</h1>
              <p className="text-sm text-slate-600">
                DREAD #5 mitigation: detects if any audit log entry has been modified by re-computing
                its HMAC signature with the separate log signing key (NFR13).
              </p>
            </div>
            {error && <Banner type="error" message={error} onDismiss={() => setError(null)}/>}

            <div className={cls.card}>
              <button onClick={runCheck} disabled={loading} className={cls.btnPrimary}>
                {loading ? <Spinner size={16}/> : <Icon.Refresh width={16} height={16}/>}
                {loading ? "Running…" : "Run integrity check"}
              </button>

              {result && (
                <div className="mt-6 space-y-4">
                  <div className="grid gap-4 sm:grid-cols-3">
                    <Stat label="Total logs" value={result.total} color="slate"/>
                    <Stat label="Valid (HMAC matches)" value={result.valid} color="emerald"/>
                    <Stat label="Tampered" value={result.tampered} color={result.tampered > 0 ? "red" : "slate"}/>
                  </div>
                  {result.tampered === 0 ? (
                    <Banner type="success" message="All audit log entries pass HMAC verification. No tampering detected."/>
                  ) : (
                    <div className="space-y-2">
                      <Banner type="error" message={`${result.tampered} log entries failed HMAC verification — possible tampering.`}/>
                      <details className="text-sm">
                        <summary className="cursor-pointer text-slate-700">Show tampered entry IDs</summary>
                        <ul className="mt-2 space-y-1 font-mono text-xs text-slate-600">
                          {result.tampered_ids.map(id => <li key={id}>{id}</li>)}
                        </ul>
                      </details>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        );
      }

      function Stat({ label, value, color = "slate" }) {
        const colors = {
          slate: "bg-slate-50 text-slate-700",
          emerald: "bg-emerald-50 text-emerald-700",
          red: "bg-red-50 text-red-700",
        };
        return (
          <div className={`rounded-lg p-4 ${colors[color]}`}>
            <p className="text-xs font-medium uppercase tracking-wide opacity-80">{label}</p>
            <p className="mt-1 text-2xl font-bold">{value}</p>
          </div>
        );
      }

      // ============================================================
      // 6. ROUTER + APP ROOT
      // ============================================================

      // Tiny hash router: tracks window.location.hash and re-renders.
      // For an academic project, this is plenty — no need for react-router.
      function useHashRoute() {
        const [route, setRoute] = useState(window.location.hash || "#/login");
        useEffect(() => {
          const onHash = () => setRoute(window.location.hash || "#/login");
          window.addEventListener("hashchange", onHash);
          return () => window.removeEventListener("hashchange", onHash);
        }, []);
        return route.replace(/^#/, "").split("?")[0]; // strip query for routing
      }

      function AppContent() {
        const route = useHashRoute();
        const { user, isAuthenticated } = useAuth();

        // Public routes
        if (!isAuthenticated) {
          if (route.startsWith("/register")) return <RegisterPage/>;
          return <LoginPage/>;
        }

        // Authenticated routing
        let page;
        if (route.startsWith("/dashboard")) {
          page = user.role === Role.ADMIN ? <AdminUsersPage/> : <DashboardPage/>;
        } else if (route.startsWith("/documents")) {
          if (user.role === Role.ADMIN) {
            // FR11 enforcement at the UI: redirect admin away from documents
            window.location.hash = "#/admin"; return null;
          }
          page = <DocumentsPage/>;
        } else if (route.startsWith("/requests")) {
          if (user.role === Role.ADMIN || user.role === Role.CLIENT) {
            window.location.hash = user.role === Role.ADMIN ? "#/admin" : "#/dashboard";
            return null;
          }
          page = <RequestsPage/>;
        } else if (route.startsWith("/admin/audit")) {
          if (user.role !== Role.ADMIN) { window.location.hash = "#/dashboard"; return null; }
          page = <AuditIntegrityPage/>;
        } else if (route.startsWith("/admin")) {
          if (user.role !== Role.ADMIN) { window.location.hash = "#/dashboard"; return null; }
          page = <AdminUsersPage/>;
        } else if (route.startsWith("/profile")) {
          page = <ProfilePage/>;
        } else {
          // Default landing — role-aware
          window.location.hash = user.role === Role.ADMIN ? "#/admin" : "#/dashboard";
          return null;
        }

        return <AppLayout currentRoute={route}>{page}</AppLayout>;
      }

      function App() {
        return (
          <AuthProvider>
            <AppContent/>
          </AuthProvider>
        );
      }

      ReactDOM.createRoot(document.getElementById("root")).render(<App/>);
    </script>
  </body>
</html>
