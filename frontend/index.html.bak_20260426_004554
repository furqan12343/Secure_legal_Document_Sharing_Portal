      function DeleteUserForm({ onError, onSuccess }) {
        const [userId, setUserId] = useState("");
        const [submitting, setSubmitting] = useState(false);

        async function onSubmit(e) {
          e.preventDefault();
          if (!confirm("Deactivate this user? They will no longer be able to log in. Audit trail is preserved.")) return;
