      // --- Dashboard ---
      function DashboardPage() {
        const { user } = useAuth();
        const [docs, setDocs] = useState([]);
        const [pending, setPending] = useState(0);
        const [loading, setLoading] = useState(true);
        const [error, setError] = useState(null);

        useEffect(() => {
          let cancelled = false;
          (async () => {
            try {
              const data = await api("/documents/");
              if (!cancelled) setDocs(data.documents || []);
              if (user.role === Role.LAWYER) {
                try {
                  const pd = await api("/sharing/pending");
                  if (!cancelled) setPending(pd.requests?.length ?? 0);
                } catch {}
              }
            } catch (err) {
              if (!cancelled) setError(err.error);
            } finally {
              if (!cancelled) setLoading(false);
            }
          })();
          return () => { cancelled = true; };
        }, [user.role]);

        if (loading) return <PageLoader/>;

        const owned = docs.filter(d => d.owner_id === user.user_id);
        const shared = docs.filter(d => d.owner_id !== user.user_id);
        const recent = [...docs].sort((a,b) => new Date(b.uploaded_at) - new Date(a.uploaded_at)).slice(0,5);

        return (
          <div className="space-y-6">
            <div>
              <h1 className="text-2xl font-bold text-slate-900">Welcome back, {user.email}</h1>
              <p className="text-sm text-slate-600">Here's an overview of your documents and activity.</p>
            </div>
            {error && <Banner type="error" message={error}/>}

            <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              <StatCard icon={Icon.Files} label={user.role === Role.ASSISTANT ? "Shared with me" : "My documents"}
                value={user.role === Role.ASSISTANT ? shared.length : owned.length}/>
              <StatCard icon={Icon.ShieldCheck} label="Total accessible" value={docs.length}/>
              {user.role === Role.LAWYER && <StatCard icon={Icon.Inbox} label="Pending requests" value={pending} highlight={pending>0}/>}
              {(user.role === Role.LAWYER || user.role === Role.CLIENT) &&
                <StatCard icon={Icon.Upload} label="Quick action" value="Upload" href="#/documents"/>}
            </div>

            <div className={cls.card}>
              <div className="mb-4 flex items-center justify-between">
                <h2 className="text-lg font-semibold text-slate-900">Recent documents</h2>
                <a href="#/documents" className="text-sm font-medium text-primary-600 hover:text-primary-700">View all →</a>
              </div>
              {recent.length === 0 ? (
                <EmptyState title="No documents yet"
                  description={user.role === Role.ASSISTANT ? "Documents shared with you will appear here." : "Upload your first document to get started."}
                  action={user.role !== Role.ASSISTANT && <a href="#/documents" className={cls.btnPrimary}><Icon.Upload width={16} height={16}/>Upload</a>}/>
              ) : (
                <div className="overflow-hidden rounded-lg border border-slate-200">
                  <table className="min-w-full divide-y divide-slate-200">
                    <thead className="bg-slate-50">
                      <tr>
                        <Th>File</Th><Th>Size</Th><Th>Status</Th><Th>Uploaded</Th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-200 bg-white">
                      {recent.map(d => (
                        <tr key={d.id}>
                          <Td className="font-medium">{d.original_filename}</Td>
                          <Td>{formatBytes(d.file_size)}</Td>
                          <Td><StatusBadge status={d.malware_scan_status}/></Td>
                          <Td>{formatDate(d.uploaded_at)}</Td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        );
      }

      function StatCard({ icon: I, label, value, href, highlight }) {
        const inner = (
          <div className={`${cls.card} flex items-center gap-4 ${href ? "cursor-pointer hover:shadow-md" : ""} ${highlight ? "ring-2 ring-amber-300" : ""}`}>
            <div className={`rounded-lg p-3 ${highlight ? "bg-amber-100 text-amber-700" : "bg-primary-50 text-primary-600"}`}>
              <I width={20} height={20}/>
            </div>
            <div>
              <p className="text-xs font-medium uppercase tracking-wide text-slate-500">{label}</p>
              <p className="text-2xl font-bold text-slate-900">{value}</p>
            </div>
          </div>
        );
        return href ? <a href={href}>{inner}</a> : inner;
      }
      function Th({ children }) { return <th className="px-4 py-2 text-left text-xs font-medium uppercase tracking-wide text-slate-500">{children}</th>; }
      function Td({ children, className = "" }) { return <td className={`px-4 py-3 text-sm text-slate-700 ${className}`}>{children}</td>; }

      // --- Documents page (Scenarios 1, 2, 4 in one page) ---
      function DocumentsPage() {
        const { user } = useAuth();
        const [docs, setDocs] = useState([]);
        const [loading, setLoading] = useState(true);
        const [error, setError] = useState(null);
        const [success, setSuccess] = useState(null);
        const [shareTarget, setShareTarget] = useState(null);
        const [requestTarget, setRequestTarget] = useState(null);

        const refresh = useCallback(async () => {
          setLoading(true); setError(null);
          try {
            const data = await api("/documents/");
            setDocs(data.documents || []);
          } catch (err) {
            setError(err.error);
          } finally {
            setLoading(false);
          }
        }, []);

        useEffect(() => { refresh(); }, [refresh]);

        async function onDownload(doc) {
          try {
            const response = await api(`/documents/${doc.id}/download`, { responseType: "blob" });
            // Trigger browser download
            const blob = await response.blob();
            const disposition = response.headers.get("content-disposition") || "";
            const m = /filename="?([^"]+)"?/.exec(disposition);
            const filename = m ? m[1] : doc.original_filename;
            const url = window.URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url; link.download = filename;
            document.body.appendChild(link); link.click(); link.remove();
            window.URL.revokeObjectURL(url);
            setSuccess(`Downloaded ${filename}`);
          } catch (err) {
            setError(err.error);
          }
        }
        async function onDelete(doc) {
          if (!confirm(`Delete "${doc.original_filename}"? This is a soft delete — audit trail is preserved.`)) return;
          try {
            await api(`/documents/${doc.id}`, { method: "DELETE" });
            setSuccess("Document deleted");
            refresh();
          } catch (err) {
            setError(err.error);
          }
        }

        if (loading) return <PageLoader/>;

        const canUpload = user.role === Role.LAWYER || user.role === Role.CLIENT;
        const canShare = user.role === Role.LAWYER;
        const canRequest = user.role === Role.ASSISTANT;

        return (
          <div className="space-y-6">
            <div>
              <h1 className="text-2xl font-bold text-slate-900">Documents</h1>
              <p className="text-sm text-slate-600">Files are AES-256-GCM encrypted at rest. Every access is logged with HMAC-signed audit entries.</p>
            </div>
            {error && <Banner type="error" message={error} onDismiss={() => setError(null)}/>}
            {success && <Banner type="success" message={success} onDismiss={() => setSuccess(null)}/>}

            {canUpload && <UploadCard onDone={(m) => { setSuccess(m); refresh(); }} onError={setError}/>}

            {docs.length === 0 ? (
              <EmptyState title="No documents" description={canUpload ? "Upload your first document above." : "No documents shared with you yet."}/>
            ) : (
              <div className="overflow-hidden rounded-lg border border-slate-200 bg-white">
                <table className="min-w-full divide-y divide-slate-200">
                  <thead className="bg-slate-50">
                    <tr>
                      <Th>File</Th><Th>Size</Th><Th>Status</Th><Th>Uploaded</Th>
                      <th className="px-4 py-3 text-right text-xs font-medium uppercase tracking-wide text-slate-500">Actions</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200 bg-white">
                    {docs.map(doc => {
                      const isOwner = doc.owner_id === user.user_id;
                      return (
                        <tr key={doc.id} className="hover:bg-slate-50">
                          <Td>
                            <div className="font-medium text-slate-900">{doc.original_filename}</div>
                            {doc.case_id && <div className="text-xs text-slate-500">Case: {doc.case_id}</div>}
                            {!isOwner && <div className="text-xs text-slate-400">Shared</div>}
                          </Td>
                          <Td>{formatBytes(doc.file_size)}</Td>
                          <Td><StatusBadge status={doc.malware_scan_status}/></Td>
                          <Td>{formatDate(doc.uploaded_at)}</Td>
                          <td className="px-4 py-3">
                            <div className="flex justify-end gap-1">
                              <IconBtn title="Download" onClick={() => onDownload(doc)}><Icon.Download width={16} height={16}/></IconBtn>
                              {canShare && isOwner && <IconBtn title="Share" onClick={() => setShareTarget(doc)}><Icon.Share width={16} height={16}/></IconBtn>}
                              {canRequest && !isOwner && <IconBtn title="Request additional permission" onClick={() => setRequestTarget(doc)}><Icon.Key width={16} height={16}/></IconBtn>}
                              {isOwner && <IconBtn title="Delete" danger onClick={() => onDelete(doc)}><Icon.Trash width={16} height={16}/></IconBtn>}
                            </div>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            )}

            {shareTarget && <ShareModal doc={shareTarget} onClose={() => setShareTarget(null)} onDone={(m) => { setShareTarget(null); setSuccess(m); }} onError={setError}/>}
            {requestTarget && <RequestModal doc={requestTarget} onClose={() => setRequestTarget(null)} onDone={(m) => { setRequestTarget(null); setSuccess(m); }} onError={setError}/>}
          </div>
        );
      }

      function IconBtn({ children, title, onClick, danger }) {
        return (
          <button type="button" onClick={onClick} title={title} aria-label={title}
            className={`rounded-md p-1.5 ${danger ? "text-red-600 hover:bg-red-50" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"}`}>
            {children}
          </button>
        );
      }

      function UploadCard({ onDone, onError }) {
        const [file, setFile] = useState(null);
        const [caseId, setCaseId] = useState("");
        const [description, setDescription] = useState("");
        const [submitting, setSubmitting] = useState(false);

        async function onSubmit(e) {
          e.preventDefault();
          if (!file) return;
          setSubmitting(true);
          try {
            const fd = new FormData();
            fd.append("file", file);
            if (caseId) fd.append("case_id", caseId);
            if (description) fd.append("description", description);
            await api("/documents/upload", { method: "POST", body: fd });
            onDone(`Uploaded ${file.name}`);
            setFile(null); setCaseId(""); setDescription("");
            // Reset the file input
            const input = document.getElementById("file-input"); if (input) input.value = "";
          } catch (err) {
            onError(err.error);
          } finally {
            setSubmitting(false);
          }
        }

        return (
          <div className={cls.card}>
            <h2 className="mb-4 flex items-center gap-2 text-lg font-semibold text-slate-900">
              <Icon.Upload width={18} height={18}/>Upload document
            </h2>
            <form onSubmit={onSubmit} className="space-y-4">
              <div className="grid gap-4 md:grid-cols-2">
                <div>
                  <label className={cls.label}>File</label>
                  <input id="file-input" type="file" required accept=".pdf,.docx,.doc,.jpg,.jpeg,.png,.txt"
                    onChange={(e) => setFile(e.target.files?.[0] ?? null)}
                    className={`${cls.input} file:mr-3 file:rounded file:border-0 file:bg-primary-50 file:px-3 file:py-1 file:text-sm file:font-medium file:text-primary-700`}
                    disabled={submitting}/>
                  <p className="mt-1 text-xs text-slate-500">Max 50MB. PDF/DOCX/DOC/JPG/PNG/TXT. Malware-scanned and AES-256-GCM encrypted before storage.</p>
                </div>
                <div>
                  <label className={cls.label}>Case ID (optional)</label>
                  <input type="text" value={caseId} onChange={(e) => setCaseId(e.target.value)}
                    className={cls.input} placeholder="CASE-2025-001" disabled={submitting} maxLength={64}/>
                </div>
              </div>
              <div>
                <label className={cls.label}>Description (optional)</label>
                <input type="text" value={description} onChange={(e) => setDescription(e.target.value)}
                  className={cls.input} disabled={submitting} maxLength={500}/>
              </div>
              <button type="submit" disabled={submitting || !file} className={cls.btnPrimary}>
                {submitting && <Spinner size={16}/>}
                {submitting ? "Uploading…" : "Upload"}
              </button>
            </form>
          </div>
        );
      }

      function ShareModal({ doc, onClose, onDone, onError }) {
        const [granteeEmail, setGranteeEmail] = useState("");
        const [permissionType, setPermissionType] = useState(PermissionType.DOWNLOAD);
        const [expires, setExpires] = useState("");
        const [submitting, setSubmitting] = useState(false);

        async function onSubmit(e) {
          e.preventDefault();
          setSubmitting(true);
          try {
            await api("/sharing/grant", {
              method: "POST",
              body: JSON.stringify({
                document_id: doc.id, grantee_email: granteeEmail,
                permission_type: permissionType,
                expires_in_days: expires === "" ? null : Number(expires),
              }),
            });
            onDone(`Shared with ${granteeEmail}`);
          } catch (err) {
            onError(err.error);
          } finally {
            setSubmitting(false);
          }
        }

        return (
          <Modal title={`Share "${doc.original_filename}"`} onClose={onClose}>
            <form onSubmit={onSubmit} className="space-y-4">
              <div>
                <label className={cls.label}>Recipient email</label>
                <input type="email" required value={granteeEmail} onChange={(e) => setGranteeEmail(e.target.value)}
                  className={cls.input} placeholder="recipient@example.com" disabled={submitting}/>
                <p className="mt-1 text-xs text-slate-500">Cannot share with admin accounts (separation of duties — FR11).</p>
              </div>
              <div>
                <label className={cls.label}>Permission type</label>
                <select value={permissionType} onChange={(e) => setPermissionType(e.target.value)} className={cls.input} disabled={submitting}>
                  <option value={PermissionType.VIEW}>View only</option>
                  <option value={PermissionType.DOWNLOAD}>Download</option>
                  <option value={PermissionType.SHARE}>Share (re-grant)</option>
                </select>
              </div>
              <div>
                <label className={cls.label}>Expires in (days, optional)</label>
                <input type="number" min={1} max={365} value={expires}
                  onChange={(e) => setExpires(e.target.value === "" ? "" : Number(e.target.value))}
                  className={cls.input} placeholder="Never expires" disabled={submitting}/>
              </div>
              <div className="flex justify-end gap-2 pt-2">
                <button type="button" onClick={onClose} className={cls.btnSecondary} disabled={submitting}>Cancel</button>
                <button type="submit" className={cls.btnPrimary} disabled={submitting}>
                  {submitting && <Spinner size={16}/>}Grant access
                </button>
              </div>
            </form>
          </Modal>
        );
      }

      function RequestModal({ doc, onClose, onDone, onError }) {
        const [justification, setJustification] = useState("");
        const [submitting, setSubmitting] = useState(false);

        async function onSubmit(e) {
          e.preventDefault();
          setSubmitting(true);
          try {
            await api("/sharing/request", {
              method: "POST",
              body: JSON.stringify({ document_id: doc.id, justification: justification || undefined }),
            });
            onDone("Permission request submitted to the document owner");
          } catch (err) {
            onError(err.error);
          } finally {
            setSubmitting(false);
          }
        }

        return (
