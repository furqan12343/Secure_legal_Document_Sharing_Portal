      // --- Register (Scenario 3) ---
      function RegisterPage() {
        const [form, setForm] = useState({ full_name:"", email:"", password:"", confirm:"", role: Role.CLIENT });
        const [error, setError] = useState(null);
        const [success, setSuccess] = useState(false);
        const [submitting, setSubmitting] = useState(false);

        const checks = {
          length: form.password.length >= 8,
          upper: /[A-Z]/.test(form.password),
          lower: /[a-z]/.test(form.password),
          digit: /[0-9]/.test(form.password),
        };
        const allOk = checks.length && checks.upper && checks.lower && checks.digit;
        const matches = form.password === form.confirm;

        async function onSubmit(e) {
          e.preventDefault();
          setError(null);
          if (!allOk)   return setError("Password does not meet strength requirements");
          if (!matches) return setError("Passwords do not match");
          setSubmitting(true);
          try {
            await api("/auth/register", {
              method: "POST",
              body: JSON.stringify({
                email: form.email, password: form.password,
                full_name: form.full_name, role: form.role,
              }),
            });
            setSuccess(true);
            setTimeout(() => { window.location.hash = "#/login"; }, 1500);
          } catch (err) {
            setError(err.error);
          } finally {
            setSubmitting(false);
          }
        }

        const upd = (k) => (e) => setForm({ ...form, [k]: e.target.value });

        return (
          <div className="flex min-h-screen items-center justify-center bg-gradient-to-br from-slate-50 to-primary-50 p-4">
            <div className="w-full max-w-md">
              <div className="mb-8 flex flex-col items-center">
                <div className="mb-3 rounded-2xl bg-primary-600 p-3 shadow-lg"><Icon.Shield width={28} height={28} className="text-white"/></div>
                <h1 className="text-2xl font-bold text-slate-900">Create account</h1>
              </div>

              <div className={cls.card}>
                {success ? (
                  <Banner type="success" message="Registration successful! Redirecting to sign in…"/>
                ) : (
                  <>
                    {error && <div className="mb-4"><Banner type="error" message={error}/></div>}
                    <form onSubmit={onSubmit} className="space-y-4" noValidate>
                      <div>
                        <label className={cls.label}>Full name</label>
                        <input type="text" required minLength={2} maxLength={100}
                          value={form.full_name} onChange={upd("full_name")} className={cls.input} disabled={submitting}/>
                      </div>
                      <div>
                        <label className={cls.label}>Email</label>
                        <input type="email" required value={form.email} onChange={upd("email")}
                          className={cls.input} disabled={submitting}/>
                      </div>
                      <div>
                        <label className={cls.label}>Role</label>
                        <select required value={form.role} onChange={upd("role")} className={cls.input} disabled={submitting}>
                          <option value={Role.LAWYER}>Lawyer</option>
                          <option value={Role.CLIENT}>Client</option>
                          <option value={Role.ASSISTANT}>Assistant</option>
                          <option value={Role.ADMIN}>Admin</option>
                        </select>
                      </div>
                      <div>
                        <label className={cls.label}>Password</label>
                        <input type="password" required minLength={8} maxLength={72}
                          value={form.password} onChange={upd("password")} className={cls.input} disabled={submitting}/>
                        {form.password && (
                          <ul className="mt-2 space-y-0.5 text-xs">
                            <li className={checks.length ? "text-emerald-600" : "text-slate-500"}>{checks.length ? "✓" : "○"} ≥ 8 characters</li>
                            <li className={checks.upper  ? "text-emerald-600" : "text-slate-500"}>{checks.upper  ? "✓" : "○"} Uppercase letter</li>
                            <li className={checks.lower  ? "text-emerald-600" : "text-slate-500"}>{checks.lower  ? "✓" : "○"} Lowercase letter</li>
                            <li className={checks.digit  ? "text-emerald-600" : "text-slate-500"}>{checks.digit  ? "✓" : "○"} At least one digit</li>
                          </ul>
                        )}
                      </div>
                      <div>
                        <label className={cls.label}>Confirm password</label>
                        <input type="password" required value={form.confirm} onChange={upd("confirm")}
                          className={cls.input} disabled={submitting}/>
                        {form.confirm && !matches && <p className="mt-1 text-xs text-red-600">Passwords do not match</p>}
                      </div>
                      <button type="submit" disabled={submitting || !form.full_name || !form.email || !allOk || !matches}
                        className={`${cls.btnPrimary} w-full`}>
                        {submitting && <Spinner size={16}/>}
                        {submitting ? "Creating…" : "Create account"}
                      </button>
                    </form>
                    <div className="mt-4 text-center text-sm text-slate-600">
                      Already have an account?{" "}
                      <a href="#/login" className="font-medium text-primary-600 hover:text-primary-700">Sign in</a>
                    </div>
                  </>
                )}
              </div>
            </div>
          </div>
        );
      }

