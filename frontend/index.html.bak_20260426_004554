                <div className="mt-4 text-center text-sm text-slate-600">
                  Don't have an account?{" "}
                  <a href="#/register" className="font-medium text-primary-600 hover:text-primary-700">Register</a>
                </div>
              </div>

            </div>
          </div>
        );
