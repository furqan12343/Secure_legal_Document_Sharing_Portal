          try {
            await api(`/admin/users/${userId}`, { method: "DELETE" });
            onSuccess("User deactivated");
            setUserId("");
          } catch (err) {
            onError(err.error);
          } finally {
            setSubmitting(false);
          }
        }
        return (
          <form onSubmit={onSubmit} className="flex flex-wrap gap-2">
            <input type="text" required value={userId} onChange={(e) => setUserId(e.target.value)}
              placeholder="User UUID" className={`${cls.input} max-w-md font-mono text-xs`} disabled={submitting}/>
