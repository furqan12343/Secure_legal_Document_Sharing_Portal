                <h2 className="mb-1 text-lg font-semibold text-slate-900">Sign in</h2>
                <p className="mb-6 text-sm text-slate-600">Enter your credentials to continue</p>

                {sessionExpired && !error && (
                  <div className="mb-4"><Banner type="error" message="Your session expired. Please sign in again."/></div>
